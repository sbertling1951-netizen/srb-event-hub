# Install inside each application HTTPS server block (both domains).
# The member upload API carries original photo bytes. Keep this exception
# route-specific; authentication and contributor authorization remain in the app.
# Validate with nginx -t, then reload Nginx. Preserve a copy of the prior config.
location = /api/photos/upload {
    client_max_body_size 50m;
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_cache_bypass $http_upgrade;
}
